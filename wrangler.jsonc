{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sclmw",
  "account_id": "f1bc2c35209fc5a627f8b92e33f5a43a",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-20",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [
    { "pattern": "sclmw.cltbbs.com", "custom_domain": true }
  ],
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  },
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sclmw",
      "database_id": "9f209bfc-ec08-4295-aa19-bcc01158e48d"
    }
  ]
}
